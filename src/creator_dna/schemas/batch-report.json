{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "const": "2.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "development",
            "acceptance"
          ]
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "regular",
                  "cross_topic",
                  "distant",
                  "complex"
                ]
              },
              "brief": {
                "type": "string"
              },
              "human_reference": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "topic",
              "category",
              "brief",
              "human_reference"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "id",
        "purpose",
        "cases"
      ],
      "additionalProperties": false
    },
    "dataset_sha256": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "const": "2.0"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "style",
                  "quality"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "id",
              "group",
              "description",
              "minimum"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "max_originality_risk": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "schema_version",
        "dimensions",
        "max_originality_risk"
      ],
      "additionalProperties": false
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "skill_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "generation_config": {
      "type": "object",
      "properties": {
        "max_revisions": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "object"
        }
      },
      "required": [
        "max_revisions",
        "agent"
      ],
      "additionalProperties": false
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "repeat": {
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "passed",
              "failed",
              "unable"
            ]
          },
          "run_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "group": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "style",
                    "quality"
                  ]
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 5
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "enum": [
                          "script",
                          "rule",
                          "reference"
                        ]
                      },
                      "rule_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "rule_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "id",
                "group",
                "score",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "originality_risk": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          }
        },
        "required": [
          "case_id",
          "repeat",
          "category",
          "status",
          "run_id",
          "error",
          "scores",
          "originality_risk"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "completed",
        "interrupted"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "unable": {
          "type": "integer",
          "minimum": 0
        },
        "means": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5
          }
        }
      },
      "required": [
        "total",
        "passed",
        "failed",
        "unable",
        "means"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "creator_id",
    "skill_version",
    "created_at",
    "dataset",
    "dataset_sha256",
    "config",
    "repeats",
    "skill_files",
    "generation_config",
    "entries",
    "status",
    "summary"
  ],
  "additionalProperties": false
}
