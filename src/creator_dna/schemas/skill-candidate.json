{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "skill_markdown": {
      "type": "string",
      "minLength": 1
    },
    "change_notes": {
      "type": "string",
      "minLength": 1
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "target_rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "skill_markdown",
    "change_notes",
    "diagnosis",
    "target_rule_ids"
  ],
  "additionalProperties": false
}
