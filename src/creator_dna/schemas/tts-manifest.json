{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "provider", "model", "voice_asset", "created_at", "text", "audio", "sha256", "metadata", "canonical_audio", "canonical_duration_seconds", "timing_note", "segments"],
  "properties": {
    "schema_version": {"const": "3.0-03"},
    "provider": {"enum": ["qwen", "minimax"]},
    "model": {"type": "string"}, "voice_asset": {"type": "string"},
    "created_at": {"type": "string"}, "text": {"type": "string", "minLength": 1},
    "audio": {"type": "string"}, "canonical_audio": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata": {"type": "object", "required": ["duration_seconds", "sample_rate", "channels", "codec", "format", "bytes"]},
    "canonical_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "timing_note": {"type": "string"},
    "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["index", "text", "text_start", "text_end", "audio", "start_seconds", "end_seconds", "duration_seconds", "timing_basis", "word_timestamps", "provider_timestamps"], "properties": {
      "index": {"type": "integer", "minimum": 0}, "text": {"type": "string", "minLength": 1},
      "text_start": {"type": "integer", "minimum": 0}, "text_end": {"type": "integer", "minimum": 1},
      "audio": {"type": "string"}, "start_seconds": {"type": "number", "minimum": 0},
      "end_seconds": {"type": "number", "exclusiveMinimum": 0},
      "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
      "timing_basis": {"const": "measured_audio_segment_boundaries"}, "word_timestamps": {"type": "null"},
      "provider_timestamps": {"type": ["array", "object", "null"]}
    }}}
  }
}
