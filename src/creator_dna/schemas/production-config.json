{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0-05",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "frame_rate": {
              "type": "string",
              "minLength": 1
            },
            "pixel_aspect_ratio": {
              "const": "1",
              "type": "string"
            },
            "orientation": {
              "type": "string",
              "enum": [
                "portrait",
                "landscape",
                "square"
              ]
            }
          },
          "required": [
            "width",
            "height",
            "frame_rate",
            "pixel_aspect_ratio",
            "orientation"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain"
          ]
        },
        "anchor": {
          "type": "string",
          "enum": [
            "center",
            "left",
            "right"
          ]
        },
        "rect": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        },
        "crop": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0
                },
                "y": {
                  "type": "number",
                  "minimum": 0
                },
                "width": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "pad_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      },
      "required": [
        "fit",
        "anchor",
        "rect",
        "crop",
        "pad_color"
      ],
      "additionalProperties": false
    },
    "subtitle_style": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string",
          "minLength": 1
        },
        "font_size": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "highlight_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "outline_color": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "outline": {
          "type": "number",
          "minimum": 0
        },
        "shadow": {
          "type": "number",
          "minimum": 0
        },
        "position": {
          "type": "string",
          "enum": [
            "bottom",
            "top",
            "center"
          ]
        },
        "margin_x": {
          "type": "number",
          "minimum": 0
        },
        "margin_y": {
          "type": "number",
          "minimum": 0
        },
        "max_chars_per_line": {
          "type": "integer",
          "minimum": 1
        },
        "max_lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "font",
        "font_size",
        "color",
        "highlight_color",
        "outline_color",
        "outline",
        "shadow",
        "position",
        "margin_x",
        "margin_y",
        "max_chars_per_line",
        "max_lines"
      ],
      "additionalProperties": false
    },
    "background_asset_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "output",
    "layout",
    "subtitle_style",
    "background_asset_id"
  ],
  "additionalProperties": false
}
