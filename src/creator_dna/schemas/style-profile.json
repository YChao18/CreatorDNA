{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "1.0"
    },
    "creator_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "dimension": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "hook",
              "structure",
              "language",
              "rhythm",
              "emotion",
              "ending",
              "boundaries"
            ]
          },
          "instruction": {
            "type": "string",
            "minLength": 1
          },
          "confidence": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "segment_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source_id",
                "segment_index",
                "quote"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "dimension",
          "instruction",
          "confidence",
          "evidence"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "creator_id",
    "sample_count",
    "summary",
    "rules",
    "limitations"
  ],
  "additionalProperties": false
}
