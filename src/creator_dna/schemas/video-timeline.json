        "required": [
          "clip_id",
          "scene_id",
          "start",
          "end",
          "role",
          "asset_id",
          "source_start",
          "source_end",
          "layout",
          "transition",
          "selection_reason",
          "mute"
        ],
        "additionalProperties": false
      }
    },
    "subtitles": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "style": {
          "type": "object",
          "properties": {
            "font": {
              "type": "string",
              "minLength": 1
            },
            "font_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "highlight_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outline_color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "outline": {
              "type": "number",
              "minimum": 0
            },
            "shadow": {
              "type": "number",
              "minimum": 0
            },
            "position": {
              "type": "string",
              "enum": [
                "bottom",
                "top",
                "center"
