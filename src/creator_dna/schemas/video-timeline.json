        "required": [
          "clip_id",
          "scene_id",
          "start",
          "end",
          "role",
          "asset_id",
          "source_start",
          "source_end",
          "layout",
          "transition",
          "selection_reason",
          "mute"
        ],
        "additionalProperties": false
      }
