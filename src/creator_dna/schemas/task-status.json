              "total": {
                "type": [
                  "number",
                  "null"
                ],
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100
              },
              "estimated": {
                "type": "boolean"
              },
