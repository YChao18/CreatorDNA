{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "script_sha256": {
      "type": "string",
      "minLength": 1
    },
    "skill_files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1,
          "const": "2.0"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "group": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "style",
                  "quality"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "minimum": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "id",
              "group",
              "description",
              "minimum"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "max_originality_risk": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "schema_version",
        "dimensions",
        "max_originality_risk"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "passed",
        "failed",
        "unable"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "assessment": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "type": "string",
              "minLength": 1,
              "const": "2.0"
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "group": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "style",
                      "quality"
                    ]
                  },
                  "score": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "minimum": 0,
                    "maximum": 5
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1,
                          "enum": [
                            "script",
                            "rule",
                            "reference"
                          ]
                        },
                        "rule_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "rule_id",
                        "quote"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "id",
                  "group",
                  "score",
                  "reason",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "originality": {
              "type": "object",
              "properties": {
                "risk": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "unknown"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "minLength": 1,
                        "enum": [
                          "script",
                          "rule",
                          "reference"
                        ]
                      },
                      "rule_id": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "rule_id",
                      "quote"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0
                }
              },
              "required": [
                "risk",
                "reason",
                "evidence"
              ],
              "additionalProperties": false
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "dimension_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "suggestion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "minLength": 1,
                          "enum": [
                            "script",
                            "rule",
                            "reference"
                          ]
                        },
                        "rule_id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kind",
                        "rule_id",
                        "quote"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "dimension_id",
                  "description",
                  "suggestion",
                  "evidence"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          },
          "required": [
            "schema_version",
            "dimensions",
            "originality",
            "issues",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "disclaimer": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "creator_id",
    "skill_version",
    "created_at",
    "script_sha256",
    "skill_files",
    "config",
    "status",
    "reasons",
    "assessment",
    "disclaimer"
  ],
  "additionalProperties": false
}
