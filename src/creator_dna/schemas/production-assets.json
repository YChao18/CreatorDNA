{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "3.0-05",
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "product",
              "screenshot",
              "background",
              "portrait"
            ]
          },
          "media_type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "string",
            "enum": [
              "owned",
              "licensed",
              "authorized",
              "unknown",
              "denied"
            ]
          },
          "rights_note": {
            "type": "string",
            "minLength": 1
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "source_start": {
            "type": "number",
            "minimum": 0
          },
          "source_end": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "audio_offset": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "audio_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "portrait_provenance": {
            "type": "object",
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_path": {
                "type": "string",
                "minLength": 1
              },
              "source_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "framing": {
                "type": "string",
                "enum": [
                  "upper_body",
                  "source_frame"
                ]
              },
              "segments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "end": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "source_start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "source_end": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "start",
                    "end",
                    "source_start",
                    "source_end"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1
              },
              "reference_type": {
                "type": "string",
                "enum": [
                  "video",
                  "image"
                ]
              }
            },
            "required": [
              "source_id",
              "source_path",
              "source_sha256",
              "framing",
              "segments"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "asset_id",
          "kind",
          "media_type",
          "path",
          "sha256",
          "source",
          "rights",
          "rights_note",
          "topics",
          "description",
          "width",
          "height",
          "duration",
          "source_start",
          "source_end",
          "audio_offset",
          "audio_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "assets"
  ],
  "additionalProperties": false
}
