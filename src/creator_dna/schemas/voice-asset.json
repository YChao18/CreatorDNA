{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "asset_id", "creator_id", "provider", "scope", "voice_id", "models", "created_at", "source", "status", "consent", "last_used_at"],
  "properties": {
    "schema_version": {"const": "3.0-03"},
    "asset_id": {"type": "string", "pattern": "^voice-[0-9a-f]{32}$"},
    "creator_id": {"type": "string", "minLength": 1},
    "provider": {"enum": ["qwen", "minimax"]},
    "scope": {"type": "string", "minLength": 1},
    "voice_id": {"type": ["string", "null"], "minLength": 1},
    "models": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "created_at": {"type": "string"},
    "last_used_at": {"type": ["string", "null"]},
    "source": {"type": "object"},
    "status": {"enum": ["outcome_unknown", "failed", "review_required", "pending_activation", "ready", "deleted"]},
    "consent": {"type": "object", "required": ["provider", "scope", "authorized", "cloud_processing", "confirmation", "confirmed_at"], "properties": {
      "provider": {"enum": ["qwen", "minimax"]}, "scope": {"type": "string"},
      "authorized": {"const": true}, "cloud_processing": {"const": true},
      "confirmation": {"type": "string", "minLength": 1}, "confirmed_at": {"type": "string"}
    }}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["ready", "pending_activation", "review_required"]}}}, "then": {"properties": {"voice_id": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"status": {"enum": ["failed", "outcome_unknown"]}}}, "then": {"properties": {"voice_id": {"type": "null"}}}}
  ]
}
