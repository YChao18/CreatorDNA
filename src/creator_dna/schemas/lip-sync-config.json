{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "provider",
    "model",
    "repository",
    "python",
    "ffmpeg",
    "ffprobe",
    "gpu_id",
    "batch_size",
    "float16",
    "extra_margin",
    "parsing_mode",
    "fps",
    "seed"
  ],
  "properties": {
    "provider": {
      "const": "musetalk"
    },
    "model": {
      "const": "v15"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "python": {
      "type": "string",
      "minLength": 1
    },
    "ffmpeg": {
      "type": "string",
      "minLength": 1
    },
    "ffprobe": {
      "type": "string",
      "minLength": 1
    },
    "gpu_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "float16": {
      "type": "boolean"
    },
    "extra_margin": {
      "type": "integer",
      "minimum": 0,
      "maximum": 40
    },
    "parsing_mode": {
      "enum": [
        "jaw",
        "raw"
      ]
    },
    "fps": {
      "const": 25
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}
