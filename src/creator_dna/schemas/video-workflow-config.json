{
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "assets": {
      "type": "string",
      "minLength": 1
    },
    "speech": {
      "type": "string",
      "minLength": 1
    },
    "timing": {
      "type": "string",
      "minLength": 1
    },
    "production_config": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "minLength": 1
    },
    "tts": {
      "type": "string",
      "minLength": 1
    },
    "lipsync": {
      "type": "string",
      "minLength": 1
    },
    "voice_asset": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "3.0-06"
    },
    "quality": {
      "type": "boolean"
    },
    "max_revisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "director": {
      "enum": [
        "agent",
        "local"
      ]
    },
    "agent": {
      "type": "object",
      "properties": {
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "timeout": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "properties": {
        "ffmpeg": {
          "type": "string",
          "minLength": 1
        },
        "ffprobe": {
          "type": "string",
          "minLength": 1
        },
        "segment_seconds": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 120
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 51
        },
        "preset": {
          "type": "string",
          "minLength": 1
        },
        "threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "audio_mix": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "source_start": {
                "type": "number",
                "minimum": 0
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "rights": {
                "enum": [
                  "owned",
                  "licensed",
                  "authorized"
                ]
              },
              "rights_note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "path",
              "sha256",
              "start",
              "end",
              "source_start",
              "volume",
              "rights",
              "rights_note"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "alignment_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "portrait": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "library": {
          "type": "string",
          "minLength": 1
        },
        "review": {
          "type": "string",
          "minLength": 1
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "cooldown": {
          "type": "number",
          "minimum": 0
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "portrait_authorization": {
      "type": "object",
      "properties": {
        "creator_id": {
          "type": "string",
          "minLength": 1
        },
        "authorized": {
          "type": "boolean"
        },
        "processing": {
          "const": "local"
        },
        "scope": {
          "const": "selected_portraits_with_workflow_speech"
        },
        "source_sha256": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "confirmation": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "creator_id",
        "authorized",
        "processing",
        "scope",
        "source_sha256",
        "confirmation",
        "confirmed_at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "profile",
    "assets"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "required": [
          "lipsync"
        ]
      },
      "then": {
        "required": [
          "portrait",
          "portrait_authorization"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "portrait": {
            "required": [
              "image"
            ]
          }
        },
        "required": [
          "portrait"
        ]
      },
      "then": {
        "properties": {
          "portrait": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "library"
                  ]
                },
                {
                  "required": [
                    "review"
                  ]
                },
                {
                  "required": [
                    "candidate"
                  ]
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "portrait"
        ],
        "properties": {
          "portrait": {
            "not": {
              "required": [
                "image"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "portrait": {
            "required": [
              "library",
              "review"
            ]
          }
        }
      }
    }
  ]
}
