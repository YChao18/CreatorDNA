{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "development",
        "acceptance"
      ]
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "regular",
              "cross_topic",
              "distant",
              "complex"
            ]
          },
          "brief": {
            "type": "string"
          },
          "human_reference": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "topic",
          "category",
          "brief",
          "human_reference"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "purpose",
    "cases"
  ],
  "additionalProperties": false
}
