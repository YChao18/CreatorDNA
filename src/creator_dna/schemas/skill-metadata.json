{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "creator_id",
    "version",
    "status",
    "created_at",
    "run_id",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "creator_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^v[0-9]{3,}$"
    },
    "status": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "draft",
        "approved"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "parent_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "quality_gate_required": {
      "type": "boolean"
    },
    "training_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "test_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "change_notes": {
      "type": "string",
      "minLength": 1
    },
    "modified_at": {
      "type": "string",
      "minLength": 1
    },
    "skill_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
